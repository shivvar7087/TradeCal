# TradeCal Backend Environment Configuration

DB_TYPE=sqlite

# If DB_TYPE=mysql, configure your MySQL credentials below:
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=tradecal_db
MYSQL_USER=root
MYSQL_PASSWORD=

SECRET_KEY=tradecal-super-secret-key-change-in-production-2026
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Comma-separated frontend origins. Set this to your Netlify URL in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Render supplies this automatically when using render.yaml.
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/database
